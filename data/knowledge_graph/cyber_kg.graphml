  <data key="d31">[{"report_id": "ANNOCTR-INTEL471-2020-10-15-TRICKBOT-ONLINE-EMOTET-MI", "source": "Intel 471", "publication_date": "2020-10-15", "sentence_id": "ANNOCTR-INTEL471-2020-10-15-TRICKBOT-ONLINE-EMOTET-MI::p3::s6", "paragraph_id": "ANNOCTR-INTEL471-2020-10-15-TRICKBOT-ONLINE-EMOTET-MI::p3", "evidence_text": "The legal action involved Microsoft attempting to disrupt a number of Trickbot command and control server IP addresses that are in the United States.", "trigger": "targeted", "confidence": 0.85, "polarity": "positive", "observation_time": "2020-10-15", "scope": "sentence_level"}, {"report_id": "ANNOCTR-PROOFPOINT-2021-04-15-THREAT-ACTORS-PAIR-TAX-TH", "source": "Proofpoint", "publication_date": "2021-04-15", "sentence_id": "ANNOCTR-PROOFPOINT-2021-04-15-THREAT-ACTORS-PAIR-TAX-TH::p9::s3", "paragraph_id": "ANNOCTR-PROOFPOINT-2021-04-15-THREAT-ACTORS-PAIR-TAX-TH::p9", "evidence_text": "TrickBot is designed to steal banking information and acts as an initial payload for additional malware, gaining notoriety in 2018 for distributing Ryuk ransomware which [reportedly] (https:// www.securitymagazine.com/articles/93769-ryuk-ransomware-responsible-for-one-third-of-all-ransomware-attacks-in-2020) accounted for a third of [ransomware] (https:// www.proofpoint.com/us/threat-reference/ransomware) distributed by many actors across the threat landscape in 2020.", "trigger": "attacks", "confidence": 0.95, "polarity": "positive", "observation_time": "2021-04-15", "scope": "sentence_level"}]</data>
