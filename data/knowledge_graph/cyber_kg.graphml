<edge source="ThreatActor::CURIUM" target="Organization::Defense Industrial Base" id="TARGETS">
  <data key="d15">TARGETS</data>
  <data key="d16">0.95</data>
  <data key="d17">HIGH</data>
  <data key="d18">positive</data>
  <data key="d19">2021-07-28</data>
  <data key="d20">sentence_level</data>
  <data key="d21">5</data>
  <data key="d22">ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE</data>
  <data key="d23">Proofpoint</data>
  <data key="d24">2021-07-28</data>
  <data key="d25">ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p1::s0</data>
  <data key="d26">* The malware, dubbed by Proofpoint as LEMPO, was designed to establish persistence, perform reconnaissance, and exfiltrate sensitive information. * TA456 actively targets smaller subsidiaries and contractors in support of efforts to compromise larger defense contractors using a supply chain compromise. * While targeting defense contractors is not new for TA456, this campaign uniquely establishes the group as one of the most determined Iranian-aligned threat actors tracked by Proofpoint because of its significant use of social engineering, cross platform communication, and general persistence. # # # Overview</data>
  <data key="d27">targets</data>
  <data key="d28">ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE</data>
  <data key="d29">Proofpoint</data>
  <data key="d30">2021-07-28</data>
  <data key="d31">[{"report_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE", "source": "Proofpoint", "publication_date": "2021-07-28", "sentence_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p1::s0", "paragraph_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p1", "evidence_text": "* The malware, dubbed by Proofpoint as LEMPO, was designed to establish persistence, perform reconnaissance, and exfiltrate sensitive information. * TA456 actively targets smaller subsidiaries and contractors in support of efforts to compromise larger defense contractors using a supply chain compromise. * While targeting defense contractors is not new for TA456, this campaign uniquely establishes the group as one of the most determined Iranian-aligned threat actors tracked by Proofpoint because of its significant use of social engineering, cross platform communication, and general persistence. # # # Overview", "trigger": "targets", "confidence": 0.95, "polarity": "positive", "observation_time": "2021-07-28", "scope": "sentence_level"}, {"report_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE", "source": "Proofpoint", "publication_date": "2021-07-28", "sentence_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p20::s1", "paragraph_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p20", "evidence_text": "On July 15, 2021, [Facebook announced] (https:// about.fb.com/news/2021/07/taking-action-against-hackers-in-iran /) they had disrupted a network of Facebook and Instagram personas, including \" Marcella ' s, \" they attributed to the Iranian-aligned actor. # # # Targets TA456 routinely conducts reconnaissance campaigns disguised as news related spam that target individuals employed by aerospace defense contractors.", "trigger": "target", "confidence": 0.95, "polarity": "positive", "observation_time": "2021-07-28", "scope": "sentence_level"}, {"report_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE", "source": "Proofpoint", "publication_date": "2021-07-28", "sentence_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p21::s0", "paragraph_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p21", "evidence_text": "The targeting of U.S. defense contractors, particularly those supporting contracts in the Middle East, is consistent with historical Iranian cyber activity.", "trigger": "contextual:targeting", "confidence": 0.82, "polarity": "positive", "observation_time": "2021-07-28", "scope": "sentence_level"}, {"report_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE", "source": "Proofpoint", "publication_date": "2021-07-28", "sentence_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p22::s0", "paragraph_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p22", "evidence_text": "This is consistent with TA456 ' s TTP of targeting business and information technology-related individuals within their target organization. # # # Attribution Proofpoint attributes this campaign to TA456, an Iranian-aligned adversary focused on espionage efforts against defense industrial base employees and contractors, particularly those supporting efforts in the Middle East.", "trigger": "targeting", "confidence": 0.95, "polarity": "positive", "observation_time": "2021-07-28", "scope": "sentence_level"}, {"report_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE", "source": "Proofpoint", "publication_date": "2021-07-28", "sentence_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p24::s0", "paragraph_id": "ANNOCTR-PROOFPOINT-2021-07-28-I-KNEW-YOU-WERE-TROUBLE::p24", "evidence_text": "TA456 demonstrated a significant operational investment by cultivating a relationship with a target ' s employee over years in order to deploy LEMPO to conduct reconnaissance into a highly secured target environment within the defense industrial base.", "trigger": "target", "confidence": 0.95, "polarity": "positive", "observation_time": "2021-07-28", "scope": "sentence_level"}]</data>
</edge>
